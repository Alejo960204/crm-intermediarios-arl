DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_intermediarios_arl
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
# Carpeta donde se guardan los PDF de soporte (opcional; por defecto backend/uploads)
# UPLOADS_DIR=

# --- Requerimiento 8: envío del código de verificación por correo (SMTP) ---
# Interruptor: false = entrar solo con contraseña (pruebas); true = exigir el código enviado al correo.
# Antes de usar el sistema con usuarios reales, cámbialo a true.
VERIFICACION_CORREO=false
# Si SMTP_HOST queda vacío, el código NO se envía: se imprime en la consola del backend (solo para pruebas).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls, usuario = tu correo y
#        SMTP_PASSWORD = una «contraseña de aplicación» (no la contraseña normal de la cuenta).
# Outlook/Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURITY=starttls
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Reglas del código (valores por defecto)
CODIGO_MINUTOS=10
CODIGO_MAX_INTENTOS=5
CODIGO_REENVIO_SEGUNDOS=60
